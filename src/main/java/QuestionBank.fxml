<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<!--
 Course: CST338 - Software Design
 Project: Trivia and Study Application
 Component: Slice 2 (Question Bank) - layout for the question bank window

 questions in a list up top, form under it to add one, buttons at the bottom.
 Author: William Delgado
 Date: August 4, 2026
-->

<VBox spacing="10.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="My Question Bank" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <ListView fx:id="listQuestions" prefHeight="150.0"/>

    <Label text="New Question" style="-fx-font-weight: bold;"/>

    <VBox spacing="5.0">
        <Label text="Prompt:"/>
        <TextField fx:id="txtPrompt"/>
    </VBox>

    <VBox spacing="5.0">
        <Label text="Correct Answer:"/>
        <TextField fx:id="txtAnswer"/>
    </VBox>

    <VBox spacing="5.0">
        <Label text="Wrong Answer 1:"/>
        <TextField fx:id="txtWrong1"/>
    </VBox>

    <VBox spacing="5.0">
        <Label text="Wrong Answer 2:"/>
        <TextField fx:id="txtWrong2"/>
    </VBox>

    <VBox spacing="5.0">
        <Label text="Wrong Answer 3:"/>
        <TextField fx:id="txtWrong3"/>
    </VBox>

    <Label fx:id="lblMessage" textFill="RED" visible="false" wrapText="true"/>

    <HBox spacing="10.0">
        <Button text="Add Question" onAction="#handleAdd" prefWidth="130.0"/>
        <Button text="Delete Selected" onAction="#handleDelete" prefWidth="130.0"/>
    </HBox>
</VBox>
